#!/usr/bin/env bash
set -euo pipefail

action="${1:-status}"
project_arg="${2:-}"
projects_dir="$HOME/.config/claude-rc/projects"

select_project() {
  if [[ -n "$project_arg" ]]; then
    printf '%s\n' "$project_arg"
    return
  fi
  if [[ -n "${CLAUDE_RC_PROJECT:-}" ]]; then
    printf '%s\n' "$CLAUDE_RC_PROJECT"
    return
  fi

  local -a projects=()
  local path
  shopt -s nullglob
  for path in "$projects_dir"/*; do
    [[ -e "$path" ]] || continue
    projects+=("$(basename "$path")")
  done
  shopt -u nullglob

  if (( ${#projects[@]} == 1 )); then
    printf '%s\n' "${projects[0]}"
    return
  fi
  if (( ${#projects[@]} == 0 )); then
    echo "No Claude Remote Control projects are registered under $projects_dir" >&2
  else
    echo "Multiple Claude Remote Control projects are registered; pass one explicitly:" >&2
    printf '  %s\n' "${projects[@]}" >&2
  fi
  return 2
}

resolve_project_root() {
  local project="$1"
  local link="$projects_dir/$project"
  if [[ ! -e "$link" ]]; then
    echo "Claude Remote Control project is not registered: $project ($link)" >&2
    return 2
  fi
  readlink -f "$link"
}

project=""
unit=""
if [[ "$action" != "list" ]]; then
  project="$(select_project)"
  unit="$(systemd-escape --template=claude-rc@.service -- "$project")"
fi

wait_state() {
  local expected="$1"
  for _ in $(seq 1 30); do
    if [[ "$(systemctl --user is-active "$unit" 2>/dev/null || true)" == "$expected" ]]; then
      return 0
    fi
    sleep 1
  done
  echo "$unit did not reach $expected within 30 seconds" >&2
  return 1
}

case "$action" in
  start)
    echo "Starting Claude Remote Control: $project..."
    systemctl --user start "$unit"
    wait_state active
    echo "Claude Remote Control is active."
    ;;
  stop)
    echo "Stopping Claude Remote Control: $project..."
    systemctl --user stop "$unit"
    wait_state inactive
    echo "Claude Remote Control is stopped."
    ;;
  restart)
    echo "Restarting Claude Remote Control: $project..."
    systemctl --user restart "$unit"
    wait_state active
    echo "Claude Remote Control is active."
    ;;
  enable)
    systemctl --user enable --now "$unit"
    wait_state active
    echo "Claude Remote Control is enabled and active: $project"
    ;;
  disable)
    systemctl --user disable --now "$unit"
    wait_state inactive
    echo "Claude Remote Control is disabled and stopped: $project"
    ;;
  status)
    systemctl --user status "$unit" --no-pager || true
    ;;
  logs)
    exec journalctl --user -u "$unit" -n "${3:-100}" --no-pager
    ;;
  config)
    root="$(resolve_project_root "$project")"
    systemctl --user cat "$unit"
    printf '\nProject link: %s\n' "$projects_dir/$project"
    printf 'Working directory: %s\n' "$root"
    ;;
  sync)
    root="$(resolve_project_root "$project")"
    exec "$HOME/.local/bin/agent-sync" --root "$root"
    ;;
  sync-force)
    root="$(resolve_project_root "$project")"
    exec "$HOME/.local/bin/agent-sync" --root "$root" --force
    ;;
  sync-status)
    root="$(resolve_project_root "$project")"
    exec "$HOME/.local/bin/agent-sync" status --root "$root"
    ;;
  list)
    systemctl --user list-units 'claude-rc@*.service' --all --no-pager
    ;;
  *)
    echo "Usage: claude-rc {start|stop|restart|status|logs|enable|disable|config|list|sync|sync-force|sync-status} [project]" >&2
    exit 2
    ;;
esac
