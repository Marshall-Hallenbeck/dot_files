#!/usr/bin/env python3
from __future__ import annotations

import fcntl
import json
import math
import os
import re
import signal
import subprocess
import time
import urllib.request
from pathlib import Path

SEMVER_NUMBER = r"(?:0|[1-9][0-9]*)"
SEMVER_PRERELEASE_IDENTIFIER = (
    r"(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)"
)
SEMVER_SOURCE = (
    rf"{SEMVER_NUMBER}\.{SEMVER_NUMBER}\.{SEMVER_NUMBER}"
    rf"(?:-{SEMVER_PRERELEASE_IDENTIFIER}(?:\.{SEMVER_PRERELEASE_IDENTIFIER})*)?"
    r"(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?"
)
SEMVER = re.compile(SEMVER_SOURCE)
CLI_VERSION = re.compile(
    rf"(?<![0-9A-Za-z.+-])({SEMVER_SOURCE})(?![0-9A-Za-z.+-])"
)
UNIT = "codex-app-server.service"
DEFAULT_REGISTRY_URL = "https://registry.npmjs.org/@openai%2Fcodex/latest"
DEFAULT_COMMAND_TIMEOUT = 30.0
DEFAULT_UPDATE_TIMEOUT = 300.0


def output(command: list[str], timeout: float = DEFAULT_COMMAND_TIMEOUT) -> str:
    return subprocess.run(
        command, check=True, capture_output=True, text=True, timeout=timeout
    ).stdout.strip()


def parse_semver(value: str) -> str:
    match = SEMVER.fullmatch(value)
    if match is None:
        raise RuntimeError(f"Invalid semantic version: {value!r}")
    return match.group(0)


def parse_cli_version(value: str) -> str:
    match = CLI_VERSION.search(value)
    if match is None:
        raise RuntimeError(f"Could not parse Codex version from: {value!r}")
    return match.group(1)


def version_parts(value: str) -> tuple[tuple[int, int, int], tuple[str, ...] | None]:
    without_build = value.split("+", 1)[0]
    core_text, separator, prerelease_text = without_build.partition("-")
    major, minor, patch = (int(part) for part in core_text.split("."))
    prerelease = tuple(prerelease_text.split(".")) if separator else None
    return (major, minor, patch), prerelease


def compare_prerelease(left: tuple[str, ...] | None, right: tuple[str, ...] | None) -> int:
    if left is None and right is None:
        return 0
    if left is None:
        return 1
    if right is None:
        return -1
    for left_part, right_part in zip(left, right):
        if left_part == right_part:
            continue
        left_numeric = left_part.isdigit()
        right_numeric = right_part.isdigit()
        if left_numeric and right_numeric:
            return (int(left_part) > int(right_part)) - (int(left_part) < int(right_part))
        if left_numeric != right_numeric:
            return -1 if left_numeric else 1
        return (left_part > right_part) - (left_part < right_part)
    return (len(left) > len(right)) - (len(left) < len(right))


def compare_versions(left: str, right: str) -> int:
    left_core, left_prerelease = version_parts(left)
    right_core, right_prerelease = version_parts(right)
    if left_core != right_core:
        return (left_core > right_core) - (left_core < right_core)
    return compare_prerelease(left_prerelease, right_prerelease)


def fetch_latest(url: str) -> str:
    with urllib.request.urlopen(url, timeout=30) as response:
        payload = json.load(response)
    if not isinstance(payload, dict) or not isinstance(payload.get("version"), str):
        raise RuntimeError("Codex registry response did not contain a string version")
    return parse_semver(payload["version"])


def discover_npm(home: Path) -> str:
    current_binary = home / ".codex/packages/standalone/current/codex"
    current_target = current_binary.resolve() if current_binary.exists() else None
    candidates: list[tuple[Path, Path]] = []
    for package in sorted(
        (home / ".nvm/versions/node").glob(
            "*/lib/node_modules/@openai/codex"
        )
    ):
        npm = package.parents[3] / "bin/npm"
        if npm.is_file() and os.access(npm, os.X_OK):
            candidates.append((package.resolve(), npm))
    if current_target is not None:
        for package, npm in candidates:
            if current_target.is_relative_to(package):
                return str(npm)
        raise RuntimeError(
            f"Active Codex binary {current_target} does not belong to a discovered NVM package"
        )
    if len(candidates) == 1:
        return str(candidates[0][1])
    raise RuntimeError(
        "Could not identify the NVM npm installation that owns @openai/codex"
    )


def positive_timeout(name: str, default: float) -> float:
    raw_value = os.environ.get(name, str(default))
    try:
        value = float(raw_value)
    except ValueError as error:
        raise RuntimeError(f"{name} must be a finite positive number") from error
    if not math.isfinite(value) or value <= 0:
        raise RuntimeError(f"{name} must be a finite positive number")
    return value


def update_npm_package(npm: str, target_version: str, timeout: float) -> None:
    environment = os.environ.copy()
    environment["PATH"] = f"{Path(npm).parent}:{environment.get('PATH', '')}"
    command = [npm, "install", "--global", f"@openai/codex@{target_version}"]
    process = subprocess.Popen(
        command,
        env=environment,
        start_new_session=True,
    )
    try:
        return_code = process.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            pass
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        if process.poll() is None:
            process.wait()
        raise
    if return_code != 0:
        raise subprocess.CalledProcessError(return_code, command)


def fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def write_pending(path: Path, installed_version: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with temporary.open("x") as stream:
        json.dump({"installedVersion": installed_version}, stream, sort_keys=True)
        stream.write("\n")
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, path)
    fsync_directory(path.parent)


def remove_pending(path: Path) -> None:
    path.unlink(missing_ok=True)
    fsync_directory(path.parent)


def service_state(
    systemctl: str, timeout: float = DEFAULT_COMMAND_TIMEOUT
) -> str:
    state = output(
        [systemctl, "--user", "show", "--property=ActiveState", "--value", UNIT],
        timeout,
    )
    if state not in {"active", "inactive", "failed", "activating", "deactivating", "reloading"}:
        raise RuntimeError(f"Unexpected {UNIT} ActiveState: {state!r}")
    return state


def wait_until_ready(codex: str, systemctl: str, target_version: str, timeout: float) -> None:
    deadline = time.monotonic() + timeout
    last_error = "service did not become ready"
    while True:
        try:
            remaining = max(0.001, deadline - time.monotonic())
            if service_state(systemctl, remaining) == "active":
                remaining = max(0.001, deadline - time.monotonic())
                payload = json.loads(
                    output(
                        [codex, "app-server", "daemon", "version"], remaining
                    )
                )
                app_version = payload.get("appServerVersion")
                if isinstance(app_version, str) and compare_versions(
                    parse_semver(app_version), target_version
                ) >= 0:
                    return
                last_error = f"App Server reported version {app_version!r}"
            else:
                last_error = f"{UNIT} is not active"
        except (json.JSONDecodeError, OSError, RuntimeError, subprocess.SubprocessError) as error:
            last_error = str(error)
        if time.monotonic() >= deadline:
            raise RuntimeError(
                f"Timed out waiting for {UNIT} at {target_version}: {last_error}"
            )
        time.sleep(min(1.0, max(0.0, deadline - time.monotonic())))


def process_pending_restart(
    pending: Path,
    codex: str,
    systemctl: str,
    installed_version: str,
    ready_timeout: float,
) -> str:
    payload = json.loads(pending.read_text())
    pending_version = payload.get("installedVersion")
    if not isinstance(pending_version, str):
        raise RuntimeError(f"Invalid pending restart marker: {pending}")
    pending_version = parse_semver(pending_version)
    if compare_versions(installed_version, pending_version) < 0:
        raise RuntimeError(
            f"Installed Codex {installed_version} is older than pending restart {pending_version}"
        )

    state = service_state(systemctl)
    if state == "active":
        payload = json.loads(
            output([codex, "app-server", "daemon", "version"], ready_timeout)
        )
        app_version_value = payload.get("appServerVersion")
        if not isinstance(app_version_value, str):
            raise RuntimeError("App Server did not report appServerVersion")
        app_version = parse_semver(app_version_value)
        if compare_versions(app_version, installed_version) >= 0:
            remove_pending(pending)
            return "App Server is already current"
        subprocess.run(
            [systemctl, "--user", "try-restart", "--no-block", UNIT],
            check=True,
            timeout=ready_timeout,
        )
        return "graceful App Server restart queued; pending marker retained"
    if state in {"inactive", "failed"}:
        remove_pending(pending)
        return "App Server was inactive and remains stopped"
    if state in {"activating", "deactivating", "reloading"}:
        return f"App Server restart deferred while state is {state}"
    raise RuntimeError(f"Refusing to update App Server while state is {state}")


def reconcile_stale_server(
    pending: Path,
    codex: str,
    systemctl: str,
    installed_version: str,
    ready_timeout: float,
) -> str | None:
    state = service_state(systemctl)
    if state in {"inactive", "failed"}:
        return None
    if state != "active":
        raise RuntimeError(f"Refusing to inspect App Server while state is {state}")
    payload = json.loads(output([codex, "app-server", "daemon", "version"]))
    app_version_value = payload.get("appServerVersion")
    if not isinstance(app_version_value, str):
        raise RuntimeError("App Server did not report appServerVersion")
    app_version = parse_semver(app_version_value)
    if compare_versions(app_version, installed_version) >= 0:
        return None
    write_pending(pending, installed_version)
    return process_pending_restart(
        pending, codex, systemctl, installed_version, ready_timeout
    )


def main() -> int:
    home = Path.home()
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", home / ".cache"))
    runtime.mkdir(parents=True, exist_ok=True)
    lock = (runtime / "codex-auto-update.lock").open("w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("codex-auto-update: another update is already running")
        return 0

    codex = os.environ.get(
        "CODEX_AUTO_UPDATE_CODEX_BIN", str(home / ".local/bin/codex")
    )
    systemctl = os.environ.get("CODEX_AUTO_UPDATE_SYSTEMCTL_BIN", "systemctl")
    npm = os.environ.get("CODEX_AUTO_UPDATE_NPM_BIN")
    registry_url = os.environ.get(
        "CODEX_AUTO_UPDATE_REGISTRY_URL", DEFAULT_REGISTRY_URL
    )
    ready_timeout = positive_timeout("CODEX_AUTO_UPDATE_READY_TIMEOUT", 90.0)
    update_timeout = positive_timeout(
        "CODEX_AUTO_UPDATE_UPDATE_TIMEOUT", DEFAULT_UPDATE_TIMEOUT
    )
    state_home = Path(os.environ.get("XDG_STATE_HOME", home / ".local/state"))
    pending = state_home / "codex-auto-update/pending-restart.json"

    current = parse_cli_version(output([codex, "--version"]))
    if pending.exists():
        result = process_pending_restart(
            pending, codex, systemctl, current, ready_timeout
        )
        print(f"codex-auto-update: completed pending action; {result}")
        return 0

    latest = fetch_latest(registry_url)
    if compare_versions(current, latest) >= 0:
        reconciliation = reconcile_stale_server(
            pending, codex, systemctl, current, ready_timeout
        )
        if reconciliation is not None:
            print(f"codex-auto-update: reconciled installed App Server; {reconciliation}")
        print(f"codex-auto-update: {current} is already current (registry {latest})")
        return 0

    refreshed_current = parse_cli_version(output([codex, "--version"]))
    if compare_versions(refreshed_current, current) != 0:
        current = refreshed_current
    if compare_versions(current, latest) >= 0:
        reconciliation = reconcile_stale_server(
            pending, codex, systemctl, current, ready_timeout
        )
        if reconciliation is not None:
            print(f"codex-auto-update: reconciled installed App Server; {reconciliation}")
        print(
            f"codex-auto-update: concurrent install advanced to {current}; "
            f"registry target {latest} was not installed"
        )
        return 0

    update_npm_package(npm or discover_npm(home), latest, update_timeout)
    installed = parse_cli_version(output([codex, "--version"]))
    if compare_versions(installed, current) <= 0:
        raise RuntimeError(
            f"Codex update did not advance the installed version: {current} -> {installed}"
        )
    if compare_versions(installed, latest) < 0:
        raise RuntimeError(
            f"Codex update installed {installed}, which is older than registry target {latest}"
        )

    write_pending(pending, installed)
    result = process_pending_restart(
        pending, codex, systemctl, installed, ready_timeout
    )
    print(f"codex-auto-update: updated {current} -> {installed}; {result}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
