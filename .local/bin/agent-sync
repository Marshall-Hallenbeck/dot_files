#!/usr/bin/env python3
"""Synchronize canonical Ruler configuration to Claude Code and Codex."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import pathlib
import subprocess
import sys
import tempfile
import time

try:
    import tomllib
except ModuleNotFoundError:  # Python 3.10 on Ubuntu 22.04
    import tomlkit

    class _TomlKitCompat:
        @staticmethod
        def loads(content: str) -> dict:
            return tomlkit.parse(content).unwrap()

    tomllib = _TomlKitCompat()

HOME = pathlib.Path.home()
STATE_DIR = HOME / ".cache/agent-sync"
RULER = HOME / ".local/bin/ruler"
COMPAT_SYNC = HOME / ".local/bin/codex-config-sync"
EXPECTED_RULER_VERSION = "0.3.44"


def git_root(path: pathlib.Path) -> pathlib.Path:
    result = subprocess.run(
        ["git", "-C", str(path), "rev-parse", "--show-toplevel"],
        check=True,
        capture_output=True,
        text=True,
    )
    return pathlib.Path(result.stdout.strip()).resolve()


def discover_roots(projects_dir: pathlib.Path | None = None) -> list[pathlib.Path]:
    """Return unique Ruler-enabled roots registered as Claude RC projects."""
    projects_dir = projects_dir or HOME / ".config/claude-rc/projects"
    if not projects_dir.is_dir():
        return []
    roots: set[pathlib.Path] = set()
    for project in projects_dir.iterdir():
        try:
            root = project.resolve(strict=True)
        except (FileNotFoundError, RuntimeError):
            continue
        if (root / ".ruler/ruler.toml").is_file():
            roots.add(root)
    return sorted(roots, key=str)


def update_digest(digest: "hashlib._Hash", path: pathlib.Path, label: str) -> None:
    digest.update(label.encode())
    digest.update(b"\0")
    if path.is_symlink():
        digest.update(b"symlink\0")
        digest.update(os.readlink(path).encode())
        digest.update(b"\0")
        try:
            update_digest(digest, path.resolve(strict=True), f"{label}:target")
        except (FileNotFoundError, RuntimeError):
            digest.update(b"broken-symlink\0")
        return
    if not path.exists():
        digest.update(b"missing\0")
        return
    if path.is_file():
        digest.update(b"file\0")
        digest.update(path.read_bytes())
        digest.update(b"\0")
        return
    digest.update(b"dir\0")
    for child in sorted(path.rglob("*")):
        relative = str(child.relative_to(path))
        if child.is_symlink():
            digest.update(relative.encode() + b"\0symlink\0" + os.readlink(child).encode() + b"\0")
            try:
                update_digest(
                    digest,
                    child.resolve(strict=True),
                    f"{label}:{relative}:target",
                )
            except (FileNotFoundError, RuntimeError):
                digest.update(b"broken-symlink\0")
        elif child.is_file():
            digest.update(relative.encode() + b"\0file\0" + child.read_bytes() + b"\0")


def digest_paths(paths: dict[str, pathlib.Path]) -> str:
    digest = hashlib.sha256()
    for label, path in sorted(paths.items()):
        update_digest(digest, path, label)
    return digest.hexdigest()


# Ruler's own default output path per agent, used when ruler.toml does not
# override it. Ruler writes the shared half of the instructions there.
RULER_DEFAULT_OUTPUT = {"claude": "CLAUDE.md", "codex": "AGENTS.md"}


def instruction_paths(root: pathlib.Path) -> dict[str, dict[str, pathlib.Path]]:
    """Return the shared, overlay, and final instruction path for each tool.

    The shared path comes from ruler.toml, because that is where Ruler writes.
    The final path comes from .ai-config/agent-sync.toml, which lets the dotfiles
    root publish into the tracked global files instead of the repository root.
    """
    ruler_agents = tomllib.loads((root / ".ruler/ruler.toml").read_text()).get("agents", {})
    sync_config = root / ".ai-config/agent-sync.toml"
    finals = {}
    if sync_config.is_file():
        finals = tomllib.loads(sync_config.read_text()).get("instructions", {})

    paths = {}
    for tool, ruler_default in RULER_DEFAULT_OUTPUT.items():
        agent_config = ruler_agents.get(tool, {})
        shared = (
            agent_config.get("output_path_instructions")
            or agent_config.get("output_path")
            or ruler_default
        )
        paths[tool] = {
            "shared": root / shared,
            "overlay": root / f".ai-config/AGENTS.{tool}.md",
            "output": root / finals.get(tool, ruler_default),
        }
    return paths


def source_paths(root: pathlib.Path) -> dict[str, pathlib.Path]:
    return {
        "ruler": root / ".ruler",
        "claude-overlay": root / ".ai-config/AGENTS.claude.md",
        "codex-overlay": root / ".ai-config/AGENTS.codex.md",
        "agent-sync-config": root / ".ai-config/agent-sync.toml",
        "claude-settings": HOME / ".claude/settings.json",
        "claude-global-skills": HOME / ".claude/skills",
        "claude-compact-hook": HOME / ".claude/hooks/reinject-on-compact.sh",
        "claude-stop-hook": HOME / ".claude/hooks/save-insights-reminder.sh",
    }


def output_paths(root: pathlib.Path) -> dict[str, pathlib.Path]:
    instructions = instruction_paths(root)
    return {
        "claude-instructions": instructions["claude"]["output"],
        "claude-shared-instructions": instructions["claude"]["shared"],
        "codex-instructions": instructions["codex"]["output"],
        "codex-shared-instructions": instructions["codex"]["shared"],
        "claude-project-mcp": root / ".mcp.json",
        "codex-project-config": root / ".codex/config.toml",
        "codex-global-config": HOME / ".codex/config.toml",
        "codex-global-skills": HOME / ".agents/skills",
        "codex-hooks": HOME / ".codex/hooks",
    }


def hash_outputs(root: pathlib.Path) -> dict[str, str]:
    result: dict[str, str] = {}
    for label, path in output_paths(root).items():
        digest = hashlib.sha256()
        update_digest(digest, path, label)
        result[label] = digest.hexdigest()
    return result


def load_state(path: pathlib.Path) -> dict:
    try:
        return json.loads(path.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def atomic_write(path: pathlib.Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False) as handle:
        handle.write(content)
        temporary = pathlib.Path(handle.name)
    temporary.chmod(path.stat().st_mode & 0o777 if path.exists() else 0o644)
    temporary.replace(path)


def build_instructions(root: pathlib.Path) -> None:
    """Append each tool's overlay to the shared file Ruler generated.

    A tool without an overlay needs no composition: Ruler already wrote its
    final instruction file, so the shared path and the output path are the same.
    """
    for tool, paths in instruction_paths(root).items():
        if not paths["overlay"].is_file():
            continue
        shared = paths["shared"].read_text().rstrip()
        overlay = paths["overlay"].read_text().strip()
        atomic_write(
            paths["output"],
            f"{shared}\n\n<!-- {tool.capitalize()}-specific overlay -->\n\n{overlay}\n",
        )


def run_checked(command: list[str], quiet: bool) -> None:
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0:
        if result.stdout:
            print(result.stdout, end="", file=sys.stderr)
        if result.stderr:
            print(result.stderr, end="", file=sys.stderr)
        raise subprocess.CalledProcessError(result.returncode, command)
    if not quiet:
        if result.stdout:
            print(result.stdout, end="")
        if result.stderr:
            print(result.stderr, end="", file=sys.stderr)


def service_active(unit: str) -> bool:
    return subprocess.run(
        ["systemctl", "--user", "is-active", "--quiet", unit]
    ).returncode == 0


def claude_units_for_root(
    root: pathlib.Path,
    projects_dir: pathlib.Path | None = None,
    active=service_active,
) -> list[str]:
    """Return active Claude RC units whose registered project resolves to root."""
    projects_dir = projects_dir or HOME / ".config/claude-rc/projects"
    if not projects_dir.is_dir():
        return []
    wanted = root.resolve()
    units: list[str] = []
    for project in sorted(projects_dir.iterdir(), key=lambda path: path.name):
        try:
            if project.resolve(strict=True) != wanted:
                continue
        except (FileNotFoundError, RuntimeError):
            continue
        unit = subprocess.run(
            ["systemd-escape", "--template=claude-rc@.service", "--", project.name],
            check=True,
            capture_output=True,
            text=True,
        ).stdout.strip()
        if active(unit):
            units.append(unit)
    return units


def restart_services(root: pathlib.Path, changed: list[str], quiet: bool) -> None:
    codex_relevant = {
        "codex-instructions",
        "codex-shared-instructions",
        "codex-project-config",
        "codex-global-config",
        "codex-global-skills",
        "codex-hooks",
    }
    claude_relevant = {
        "claude-instructions",
        "claude-shared-instructions",
        "claude-project-mcp",
    }

    if codex_relevant.intersection(changed) and service_active("codex-app-server.service"):
        if not quiet:
            print("Restarting Codex App Server to load synchronized configuration...", flush=True)
        subprocess.run(
            ["systemctl", "--user", "restart", "codex-app-server.service"], check=True
        )
        socket = HOME / ".codex/app-server-control/app-server-control.sock"
        deadline = time.monotonic() + 90
        while time.monotonic() < deadline and not socket.is_socket():
            time.sleep(1)
        if not socket.is_socket():
            raise RuntimeError(f"Codex control socket was not ready after 90 seconds: {socket}")

    if claude_relevant.intersection(changed):
        for unit in claude_units_for_root(root):
            if not quiet:
                print(f"Restarting {unit} to load synchronized configuration...", flush=True)
            subprocess.run(["systemctl", "--user", "restart", unit], check=True)


def aggregate_return_code(current: int, child: int) -> int:
    """Keep the first failure and normalize signal exits to shell convention."""
    if current != 0 or child == 0:
        return current
    return child if child > 0 else 128 + abs(child)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", nargs="?", choices=("sync", "check", "status"), default="sync")
    project_source = parser.add_mutually_exclusive_group()
    project_source.add_argument("--root")
    project_source.add_argument(
        "--all",
        action="store_true",
        help="synchronize every Ruler project registered under ~/.config/claude-rc/projects",
    )
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--no-restart", action="store_true")
    parser.add_argument("--quiet", action="store_true")
    parser.add_argument("--skip-compat", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()

    if args.all:
        roots = discover_roots()
        return_code = 0
        if args.action == "sync":
            compat_command = [str(COMPAT_SYNC), "--compat-only", "--quiet"]
            if args.force:
                compat_command.append("--force")
            run_checked(compat_command, True)
        if not roots:
            if not args.quiet:
                print(json.dumps({"status": "no-projects", "roots": []}))
            return return_code
        for root in roots:
            command = [sys.executable, str(pathlib.Path(__file__).resolve()), args.action, "--root", str(root)]
            if args.action == "sync":
                command.append("--skip-compat")
            if args.force:
                command.append("--force")
            if args.no_restart:
                command.append("--no-restart")
            if args.quiet:
                command.append("--quiet")
            result = subprocess.run(command)
            return_code = aggregate_return_code(return_code, result.returncode)
        return return_code

    root = git_root(pathlib.Path(args.root or os.getcwd()).expanduser().resolve())
    if not (root / ".ruler/ruler.toml").is_file():
        raise RuntimeError(f"Ruler is not initialized for {root}")
    version = subprocess.run(
        [str(RULER), "--version"], check=True, capture_output=True, text=True
    ).stdout.strip()
    if version != EXPECTED_RULER_VERSION:
        raise RuntimeError(
            f"expected Ruler {EXPECTED_RULER_VERSION}, found {version}; audit and pin upgrades before use"
        )

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    key = hashlib.sha256(str(root).encode()).hexdigest()
    state_path = STATE_DIR / f"{key}.json"
    lock_path = STATE_DIR / f"{key}.lock"
    source_hash = digest_paths(source_paths(root))
    current_outputs = hash_outputs(root)
    state = load_state(state_path)

    if args.action in ("check", "status"):
        synced = (
            state.get("sourceHash") == source_hash
            and state.get("outputHashes") == current_outputs
        )
        result = {
            "status": "synced" if synced else "drifted",
            "root": str(root),
            "rulerVersion": version,
            "lastSync": state.get("updatedAt"),
        }
        print(json.dumps(result, indent=2))
        return 0 if args.action == "status" or synced else 1

    changed: list[str] = []
    with lock_path.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        source_hash = digest_paths(source_paths(root))
        before = hash_outputs(root)
        state = load_state(state_path)
        if (
            not args.force
            and state.get("sourceHash") == source_hash
            and state.get("outputHashes") == before
        ):
            if not args.quiet:
                print(json.dumps({"status": "unchanged", "root": str(root)}))
            return 0

        run_checked(
            [
                str(RULER),
                "apply",
                "--project-root",
                str(root),
                "--agents",
                "claude,codex",
                "--local-only",
                "--no-gitignore",
                "--no-backup",
                "--no-skills",
                "--no-subagents",
            ],
            args.quiet,
        )
        build_instructions(root)
        if not args.skip_compat:
            compat_command = [str(COMPAT_SYNC), "--cwd", str(root), "--compat-only", "--quiet"]
            if args.force:
                compat_command.append("--force")
            run_checked(compat_command, True)
        after = hash_outputs(root)
        changed = [name for name in sorted(after) if before.get(name) != after[name]]
        state_path.write_text(
            json.dumps(
                {
                    "sourceHash": digest_paths(source_paths(root)),
                    "outputHashes": after,
                    "updatedAt": int(time.time()),
                    "rulerVersion": version,
                    "changed": changed,
                },
                indent=2,
            )
            + "\n"
        )

    if changed and not args.no_restart:
        restart_services(root, changed, args.quiet)
    if not args.quiet:
        print(json.dumps({"status": "ok", "root": str(root), "changed": changed}, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
