#!/usr/bin/env python3
"""Stop direct Codex app servers that block native daemon bootstrap."""
from __future__ import annotations

import argparse
import os
import signal
import sys
import time
from pathlib import Path


def is_default_control_server(arguments: list[str]) -> bool:
    try:
        server_index = arguments.index("app-server")
    except ValueError:
        return False

    server_arguments = arguments[server_index + 1 :]
    if not server_arguments or server_arguments[0] in {"daemon", "proxy"}:
        return False
    if "--remote-control" in server_arguments:
        return True
    for index, argument in enumerate(server_arguments):
        if argument == "--listen" and index + 1 < len(server_arguments):
            return server_arguments[index + 1] == "unix://"
        if argument == "--listen=unix://":
            return True
    return False


def is_proxy(arguments: list[str]) -> bool:
    try:
        server_index = arguments.index("app-server")
    except ValueError:
        return False
    return arguments[server_index + 1 : server_index + 2] == ["proxy"]


def collect_servers(
    home: Path, proc_root: Path = Path("/proc")
) -> tuple[list[int], list[int], list[int]]:
    managed_root = home / ".codex/packages/app-server-daemon"
    unmanaged: list[int] = []
    managed: list[int] = []
    proxies: list[int] = []
    for entry in proc_root.iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if entry.stat().st_uid != os.getuid():
                continue
            arguments = [
                part.decode(errors="replace")
                for part in (entry / "cmdline").read_bytes().split(b"\0")
                if part
            ]
            executable = Path(os.readlink(entry / "exe").removesuffix(" (deleted)"))
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
        if is_proxy(arguments):
            proxies.append(int(entry.name))
            continue
        if not is_default_control_server(arguments):
            continue
        target = managed if executable.is_relative_to(managed_root) else unmanaged
        target.append(int(entry.name))
    return unmanaged, managed, proxies


def wait_for_exit(process_ids: list[int], seconds: int) -> list[int]:
    deadline = time.monotonic() + seconds
    remaining = process_ids
    while remaining and time.monotonic() < deadline:
        time.sleep(0.1)
        remaining = [
            process_id
            for process_id in process_ids
            if Path(f"/proc/{process_id}").exists()
        ]
    return remaining


def stop_processes(
    process_ids: list[int], name: str, seconds: int, force: bool
) -> list[int]:
    if not process_ids:
        return []
    print(f"Stopping {name}: " + ", ".join(map(str, process_ids)))
    for process_id in process_ids:
        try:
            os.kill(process_id, signal.SIGTERM)
        except ProcessLookupError:
            pass
    remaining = wait_for_exit(process_ids, seconds)
    if remaining and force:
        print(f"Forcing {name} to stop: " + ", ".join(map(str, remaining)))
        for process_id in remaining:
            try:
                os.kill(process_id, signal.SIGKILL)
            except ProcessLookupError:
                pass
        remaining = wait_for_exit(remaining, 5)
    return remaining


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--force", action="store_true")
    arguments = parser.parse_args()

    home = Path.home()
    targets, managed, proxies = collect_servers(home)
    if arguments.check:
        return 75 if not managed and (targets or proxies) else 0
    if managed or (not targets and not proxies):
        return 0

    remaining_proxies = stop_processes(
        proxies, "Codex app-server proxy", 5, arguments.force
    )
    if remaining_proxies:
        print(
            "Codex app-server proxy did not stop: "
            + ", ".join(map(str, remaining_proxies)),
            file=sys.stderr,
        )
        return 1
    new_targets, managed, _ = collect_servers(home)
    if managed:
        return 0
    targets = sorted(set(targets + new_targets))

    remaining = stop_processes(
        targets, "unmanaged Codex app-server", 30, arguments.force
    )
    if remaining:
        print(
            "Unmanaged Codex app-server did not stop: "
            + ", ".join(map(str, remaining)),
            file=sys.stderr,
        )
        return 1

    unmanaged, managed, _ = collect_servers(home)
    if unmanaged:
        print(
            "A new unmanaged Codex app-server started: "
            + ", ".join(map(str, unmanaged)),
            file=sys.stderr,
        )
        return 1
    if not managed:
        (home / ".codex/app-server-control/app-server-control.sock").unlink(
            missing_ok=True
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
