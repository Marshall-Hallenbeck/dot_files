# Per-host override files (created locally, never committed)
*.local
__pycache__/
*.py[cod]

# Machine-specific Claude local settings (ends in .json, so *.local misses it)
.claude/settings.local.json

# Re-include files that happen to have .local in their name but ARE managed
!.claude/hookify.*.local.md
!.local/
!.local/bin/
!.local/bin/dotfiles-update

# Private BBP skills/agents (symlinked from ~/.bbp, private repo)
.claude/agents/bb*
.claude/skills/bb*

# Community skills are installed, not vendored. They land in this directory
# because ~/.claude/skills symlinks here, but the content lives in ~/.agents.
.claude/skills/windows-protocols

# Secrets — never commit (defense-in-depth; nothing sensitive is tracked today)
*.pem
*.key
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
*.p12
*.pfx
*.ppk
*.kdbx
*.ovpn
.env*
*.token
.secrets/
