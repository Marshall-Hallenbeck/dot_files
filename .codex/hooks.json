{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/validate-commit-references.sh --install"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|shell_command|exec_command|functions\\.exec_command|functions\\.exec",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/validate-commit-references.sh"
          }
        ]
      }
    ]
  }
}
