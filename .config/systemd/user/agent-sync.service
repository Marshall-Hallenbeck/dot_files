[Unit]
Description=Maintain shared agent configuration and update Codex

[Service]
Type=oneshot
ExecStart=%h/.local/bin/dotfiles-update
ExecStart=%h/.local/share/codex-config-sync-venv-current/bin/python %h/.local/bin/agent-sync --all --no-restart --quiet
ExecStart=%h/.local/bin/codex-auto-update
Slice=ai-agents.slice
Nice=10
CPUQuota=50%
CPUWeight=10
IOWeight=10
IOSchedulingClass=idle
MemoryHigh=512M
MemoryMax=1G
TasksMax=64
TimeoutStartSec=10min
KillMode=control-group
