[Unit]
Description=Codex App Server with Remote Control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/rm -f %h/.codex/remote-control-stopped
ExecStartPre=%h/.local/bin/codex-config-sync --compat-only --quiet
ExecStart=%h/.codex/packages/standalone/current/codex app-server --remote-control --listen unix://
ExecStopPost=%h/.local/libexec/codex-rc-cleanup
Restart=on-failure
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=default.target
