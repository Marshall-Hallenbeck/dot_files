[Unit]
Description=Start the Codex managed daemon with Remote Control
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=%h/.local/bin/codex-config-sync --quiet
ExecStart=%h/.codex/packages/standalone/current/bin/codex remote-control start
ExecStop=%h/.codex/packages/standalone/current/bin/codex remote-control stop
TimeoutStopSec=infinity
TimeoutStartSec=300
Slice=ai-agents.slice
CPUWeight=100
IOWeight=50
TasksMax=1024
KillMode=control-group
OOMPolicy=stop

[Install]
WantedBy=default.target
