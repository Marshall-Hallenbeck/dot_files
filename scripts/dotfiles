#!/bin/bash
set -euo pipefail

DOTFILES_DIR="$HOME/.dot_files"
AI_REMOTE_CONTROL_FEATURE="ai-remote-control"
AI_REMOTE_CONTROL_MARKER="$HOME/.config/dotfiles/features/$AI_REMOTE_CONTROL_FEATURE"
AGENT_SYNC_PATHS=(
    .config/systemd/user/ai-agents.slice
    .config/systemd/user/agent-sync.service
    .config/systemd/user/agent-sync.timer
    .local/bin/agent-sync
    .local/bin/codex-config-sync
    .local/libexec/codex-config-sync.py
)
AI_REMOTE_CONTROL_PATHS=(
    "${AGENT_SYNC_PATHS[@]}"
    .config/systemd/user/agent-sync.service.d/40-maintenance.conf
    .config/systemd/user/claude-rc@.service
    .config/systemd/user/claude-rc@.service.d/40-reattach.conf
    .config/systemd/user/codex-app-server.service
    .config/systemd/user/dotfiles-update.service
    .local/bin/claude-auto-update
    .local/bin/claude-rc
    .local/bin/claude-rc-reattach
    .local/bin/codex
    .local/bin/codex-auto-update
    .local/bin/codex-rc
    .local/bin/dotfiles-update
    .local/libexec/ai-config-audit.py
    .local/libexec/codex-app-server-watchdog.py
    .local/libexec/codex-rc-cleanup
)

is_agent_sync_path() {
    local candidate="$1" path
    for path in "${AGENT_SYNC_PATHS[@]}"; do
        [ "$candidate" = "$path" ] && return 0
    done
    return 1
}

is_ai_remote_control_path() {
    local candidate="$1" path
    for path in "${AI_REMOTE_CONTROL_PATHS[@]}"; do
        [ "$candidate" = "$path" ] && return 0
    done
    return 1
}

usage() {
    echo "Usage: dotfiles <command>"
    echo ""
    echo "Commands:"
    echo "  promote <path>                         Move a local file into the repo and symlink it back"
    echo "  status                                 Show symlink status of managed files"
    echo "  sync-enable                            Install and enable automatic agent configuration sync"
    echo "  feature-enable ai-remote-control       Back up and link optional Remote Control assets"
    echo "  pull                                   Pull latest changes from remote"
    echo ""
    echo "Examples:"
    echo "  dotfiles promote ~/.claude/rules/my-rule.md"
    echo "  dotfiles status"
    echo "  dotfiles pull"
}

cmd_promote() {
    local src="$1"

    if [ ! -f "$src" ]; then
        echo "ERROR: $src does not exist or is not a file" >&2
        exit 1
    fi

    if [ -L "$src" ]; then
        echo "ERROR: $src is already a symlink" >&2
        exit 1
    fi

    # Determine the relative path from $HOME
    local rel_path="${src#"$HOME"/}"
    if [ "$rel_path" = "$src" ]; then
        echo "ERROR: $src is not under \$HOME" >&2
        exit 1
    fi

    local dest="$DOTFILES_DIR/$rel_path"
    local dest_dir
    dest_dir=$(dirname "$dest")

    mkdir -p "$dest_dir"
    mv "$src" "$dest"
    ln -s "$dest" "$src"

    echo "Promoted: $src -> $dest (symlinked back)"
    echo ""
    echo "To commit:"
    echo "  cd $DOTFILES_DIR && git add '$rel_path' && git commit -m 'feat: add $rel_path'"
}

cmd_status() {
    local ok=0 broken=0 missing=0
    local ai_remote_control_enabled=false
    [ -e "$AI_REMOTE_CONTROL_MARKER" ] && ai_remote_control_enabled=true

    # Files that live in the repo only or use a non-symlink deployment.
    local -a repo_only=(
        .gitignore
        .gitattributes
        .dockerignore
        .claude/CLAUDE.md
        .claude/project-learned-insights.md
        .gitconfig
        .zshrc
        .codex/config.toml
        .codex/verify-hook-trust.py
    )

    # Directories whose contents are repo-internal. The Ruler source and the
    # generated intermediates are inputs to agent-sync, which publishes the
    # tracked global files; nothing under them is deployed to $HOME, so a
    # matching ~/.ruler or ~/.ai-config would be wrong rather than missing.
    local -a repo_only_prefixes=(
        .ruler/
        .ai-config/
    )

    # Files deployed to a different name: repo_path -> home_path
    # global-CLAUDE.md is deployed as ~/.claude/CLAUDE.md
    local -A renames=([.claude/global-CLAUDE.md]=.claude/CLAUDE.md)

    # Read managed file list from the repo
    while IFS= read -r rel_path; do
        # Remote Control services and wrappers are audited only after the
        # feature has been explicitly deployed on this host.
        if ! $ai_remote_control_enabled && \
           is_ai_remote_control_path "$rel_path" && \
           ! is_agent_sync_path "$rel_path"; then
            continue
        fi

        # Skip repo-only files
        local skip=false
        for excluded in "${repo_only[@]}"; do
            if [ "$rel_path" = "$excluded" ]; then
                skip=true
                break
            fi
        done
        for prefix in "${repo_only_prefixes[@]}"; do
            if [ "${rel_path#"$prefix"}" != "$rel_path" ]; then
                skip=true
                break
            fi
        done
        $skip && continue

        # Handle renamed deployments
        local deploy_path="$rel_path"
        if [[ -v "renames[$rel_path]" ]]; then
            deploy_path="${renames[$rel_path]}"
        fi

        local target="$HOME/$deploy_path"
        if [ -L "$target" ]; then
            local link_dest expected_resolved
            if ! link_dest=$(readlink -f "$target") || [ ! -e "$link_dest" ]; then
                echo "  BROKEN:  $target (symlink target does not exist)"
                broken=$((broken + 1))
                continue
            fi
            local expected="$DOTFILES_DIR/$rel_path"
            if ! expected_resolved=$(readlink -f "$expected") || [ ! -e "$expected_resolved" ]; then
                echo "  BROKEN:  $expected (repo file does not exist)"
                broken=$((broken + 1))
                continue
            fi
            if [ "$link_dest" = "$expected_resolved" ]; then
                ok=$((ok + 1))
            else
                echo "  WRONG:   $target -> $link_dest (expected $expected)"
                broken=$((broken + 1))
            fi
        elif [ -f "$target" ]; then
            echo "  NOT LINK: $target (regular file, not symlinked)"
            broken=$((broken + 1))
        else
            echo "  MISSING:  $target"
            missing=$((missing + 1))
        fi
    done < <(cd "$DOTFILES_DIR" && git ls-files | grep -E '^\.' | grep -vE '^\.(gitignore|gitmodules|claude/(skills|plugins|memory|projects|worktrees))')

    echo ""
    echo "Status: $ok linked, $broken issues, $missing missing"
}

provision_codex_config_sync() {
    MANAGED_SYNC_PYTHON="${CODEX_CONFIG_SYNC_PYTHON:-$HOME/.local/share/codex-config-sync-venv-current/bin/python}"
    local managed_pip managed_invalid=0
    managed_pip="$(dirname "$MANAGED_SYNC_PYTHON")/pip"
    if [ -e "$DOTFILES_DIR/.local/bin/codex-config-sync" ] && \
       [ -e "$DOTFILES_DIR/.local/libexec/codex-config-sync.py" ]; then
        if [ ! -x "$MANAGED_SYNC_PYTHON" ] || \
           ! "$MANAGED_SYNC_PYTHON" -c 'import tomlkit, yaml' >/dev/null 2>&1; then
            managed_invalid=1
        elif [ -z "${CODEX_CONFIG_SYNC_PYTHON:-}" ] && \
             { [ ! -x "$managed_pip" ] || \
               ! "$managed_pip" --version >/dev/null 2>&1; }; then
            managed_invalid=1
        fi
        if [ "$managed_invalid" -eq 1 ]; then
            if [ -n "${CODEX_CONFIG_SYNC_PYTHON:-}" ]; then
                echo "ERROR: CODEX_CONFIG_SYNC_PYTHON cannot import tomlkit and yaml: $MANAGED_SYNC_PYTHON" >&2
                exit 1
            fi
            command -v python3 >/dev/null 2>&1 || {
                echo "ERROR: python3 is required to provision codex-config-sync" >&2
                exit 1
            }

            local managed_pointer generation link_stage
            managed_pointer="$HOME/.local/share/codex-config-sync-venv-current"
            mkdir -p "$HOME/.local/share"
            if { [ -e "$managed_pointer" ] || [ -L "$managed_pointer" ]; } && \
               [ ! -L "$managed_pointer" ]; then
                echo "ERROR: managed venv pointer is not a symlink: $managed_pointer" >&2
                exit 1
            fi

            generation="$(mktemp -d "$HOME/.local/share/codex-config-sync-venv.generation.XXXXXXXX")"
            link_stage=""
            cleanup_codex_sync_provisioning() {
                local active_generation="" canonical_generation=""
                [ -z "${link_stage:-}" ] || rm -rf -- "$link_stage"
                if [ -L "$managed_pointer" ]; then
                    active_generation="$(readlink -f "$managed_pointer" 2>/dev/null || true)"
                fi
                if [ -n "${generation:-}" ]; then
                    canonical_generation="$(readlink -f "$generation" 2>/dev/null || true)"
                    if [ -z "$canonical_generation" ]; then
                        canonical_generation="$generation"
                    fi
                    if [ "$canonical_generation" != "$active_generation" ]; then
                        rm -rf -- "$generation"
                    fi
                fi
            }
            trap 'cleanup_codex_sync_provisioning; exit 130' INT TERM HUP
            if ! python3 -m venv "$generation" || \
               ! "$generation/bin/pip" install \
                    --disable-pip-version-check --quiet \
                    'tomlkit==0.13.3' 'PyYAML==6.0.3' || \
               ! "$generation/bin/python" -c 'import tomlkit, yaml' >/dev/null 2>&1 || \
               ! "$generation/bin/pip" --version >/dev/null 2>&1; then
                echo "ERROR: failed to build a codex-config-sync generation: $generation" >&2
                cleanup_codex_sync_provisioning
                exit 1
            fi

            link_stage="$(mktemp -d "$HOME/.local/share/.codex-config-sync-link.XXXXXXXX")"
            if ! ln -s "$generation" "$link_stage/current"; then
                echo "ERROR: failed to stage codex-config-sync generation: $generation" >&2
                cleanup_codex_sync_provisioning
                exit 1
            fi
            if ! mv -Tf -- "$link_stage/current" "$managed_pointer"; then
                echo "ERROR: failed to activate codex-config-sync generation: $generation" >&2
                cleanup_codex_sync_provisioning
                exit 1
            fi
            rmdir "$link_stage"
            link_stage=""
            generation=""
            trap - INT TERM HUP
            python3 -c 'import os, sys; fd = os.open(sys.argv[1], os.O_RDONLY | os.O_DIRECTORY); os.fsync(fd); os.close(fd)' "$HOME/.local/share"
            MANAGED_SYNC_PYTHON="$managed_pointer/bin/python"
        fi
        "$MANAGED_SYNC_PYTHON" -c 'import tomlkit, yaml' >/dev/null 2>&1 || {
            echo "ERROR: managed AI configuration interpreter cannot import tomlkit and yaml: $MANAGED_SYNC_PYTHON" >&2
            exit 1
        }
        if [ -z "${CODEX_CONFIG_SYNC_PYTHON:-}" ] && \
           ! "$(dirname "$MANAGED_SYNC_PYTHON")/pip" --version >/dev/null 2>&1; then
            echo "ERROR: managed AI configuration pip is invalid: $(dirname "$MANAGED_SYNC_PYTHON")/pip" >&2
            exit 1
        fi
    fi
}

deploy_managed_paths() {
    local backup_label="$1"
    shift

    DEPLOY_BACKUP_ROOT=""
    DEPLOY_CHANGED=0
    local rel_path source target backup
    local parent_rel current component
    local -a path_parts

    for rel_path in "$@"; do
        source="$DOTFILES_DIR/$rel_path"
        [ -e "$source" ] || continue
        target="$HOME/$rel_path"
        if [ -L "$target" ] && [ "$(readlink -f "$target")" = "$(readlink -f "$source")" ]; then
            continue
        fi

        parent_rel="$(dirname "$rel_path")"
        current="$HOME"
        IFS='/' read -r -a path_parts <<< "$parent_rel"
        for component in "${path_parts[@]}"; do
            current="$current/$component"
            if [ -d "$current" ] && [ ! -L "$current" ]; then
                continue
            fi
            if [ -e "$current" ] || [ -L "$current" ]; then
                if [ -z "$DEPLOY_BACKUP_ROOT" ]; then
                    DEPLOY_BACKUP_ROOT="$(mktemp -d "$HOME/.dotfiles-backup-$backup_label-XXXXXXXX")"
                fi
                backup="$DEPLOY_BACKUP_ROOT/${current#"$HOME/"}"
                mkdir -p "$(dirname "$backup")"
                mv -- "$current" "$backup"
            fi
            mkdir "$current"
        done

        if [ -e "$target" ] || [ -L "$target" ]; then
            if [ -z "$DEPLOY_BACKUP_ROOT" ]; then
                DEPLOY_BACKUP_ROOT="$(mktemp -d "$HOME/.dotfiles-backup-$backup_label-XXXXXXXX")"
            fi
            backup="$DEPLOY_BACKUP_ROOT/$rel_path"
            mkdir -p "$(dirname "$backup")"
            mv -- "$target" "$backup"
        fi
        mkdir -p "$(dirname "$target")"
        ln -s "$source" "$target"
        DEPLOY_CHANGED=$((DEPLOY_CHANGED + 1))
    done
}

enable_agent_sync_timer() {
    if [ "${DOTFILES_SKIP_SYSTEMD:-0}" = "1" ]; then
        echo "Skipped agent-sync.timer because systemd is not the init system."
        return
    fi
    command -v systemctl >/dev/null 2>&1 || {
        echo "ERROR: systemctl is required to enable agent-sync.timer" >&2
        exit 1
    }
    local legacy_timer="$HOME/.config/systemd/user/dotfiles-update.timer"
    local legacy_source="$DOTFILES_DIR/.config/systemd/user/dotfiles-update.timer"
    if [ -L "$legacy_timer" ] && [ "$(readlink "$legacy_timer")" = "$legacy_source" ]; then
        systemctl --user disable --now dotfiles-update.timer
        unlink -- "$legacy_timer"
    fi
    systemctl --user daemon-reload
    systemctl --user enable --now agent-sync.timer
}

cmd_sync_enable() {
    local rel_path
    for rel_path in "${AGENT_SYNC_PATHS[@]}"; do
        if [ ! -e "$DOTFILES_DIR/$rel_path" ]; then
            echo "ERROR: required agent sync source is missing: $DOTFILES_DIR/$rel_path" >&2
            exit 1
        fi
    done

    provision_codex_config_sync
    deploy_managed_paths "agent-sync" "${AGENT_SYNC_PATHS[@]}"
    "$MANAGED_SYNC_PYTHON" "$HOME/.local/bin/agent-sync" sync \
        --root "$DOTFILES_DIR" --no-restart --quiet
    enable_agent_sync_timer

    echo "Enabled automatic agent configuration sync: $DEPLOY_CHANGED link(s) updated."
    if [ -n "$DEPLOY_BACKUP_ROOT" ]; then
        echo "Backups: $DEPLOY_BACKUP_ROOT"
    fi
}

cmd_feature_enable() {
    local feature="$1"
    if [ "$feature" != "$AI_REMOTE_CONTROL_FEATURE" ]; then
        echo "ERROR: Unknown feature '$feature'" >&2
        exit 1
    fi

    provision_codex_config_sync
    deploy_managed_paths "$feature" "${AI_REMOTE_CONTROL_PATHS[@]}"
    mkdir -p "$(dirname "$AI_REMOTE_CONTROL_MARKER")"
    : > "$AI_REMOTE_CONTROL_MARKER"
    enable_agent_sync_timer

    echo "Enabled $feature: $DEPLOY_CHANGED link(s) updated; consolidated synchronization timer enabled; no agent services were restarted."
    if [ -n "$DEPLOY_BACKUP_ROOT" ]; then
        echo "Backups: $DEPLOY_BACKUP_ROOT"
    fi
}

cmd_pull() {
    local head changed
    head=$(git -C "$DOTFILES_DIR" rev-parse HEAD)
    git -C "$DOTFILES_DIR" pull
    if [ -e "$AI_REMOTE_CONTROL_MARKER" ]; then
        cmd_feature_enable "$AI_REMOTE_CONTROL_FEATURE"
    fi
    # Same trigger paths as dotfiles-update; interactive pulls can re-run the
    # installer directly because sudo and the Codex trust gate can prompt here.
    changed=$(git -C "$DOTFILES_DIR" diff --name-only "$head" HEAD)
    if grep -qE '^(install_environment\.sh$|\.config/systemd/user/)' <<<"$changed"; then
        mkdir -p "$HOME/.config/dotfiles"
        printf '%s..%s\n' "$head" "$(git -C "$DOTFILES_DIR" rev-parse HEAD)" > "$HOME/.config/dotfiles/install-required"
        echo "dotfiles: installer-relevant files changed; running install_environment.sh"
        "$DOTFILES_DIR/install_environment.sh"
    fi
}

if [ $# -lt 1 ]; then
    usage
    exit 1
fi

case "$1" in
    promote)
        if [ $# -lt 2 ]; then
            echo "ERROR: promote requires a file path" >&2
            exit 1
        fi
        cmd_promote "$2"
        ;;
    status)
        cmd_status
        ;;
    sync-enable)
        cmd_sync_enable
        ;;
    feature-enable)
        if [ $# -lt 2 ]; then
            echo "ERROR: feature-enable requires a feature name" >&2
            exit 1
        fi
        cmd_feature_enable "$2"
        ;;
    pull)
        cmd_pull
        ;;
    *)
        echo "ERROR: Unknown command '$1'" >&2
        usage
        exit 1
        ;;
esac
